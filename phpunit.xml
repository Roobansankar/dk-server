<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Dummy Razorpay credentials — fixed only for deterministic HMAC
             signature assertions in RazorpayPaymentTest. Not real TEST Mode
             keys (those live in the gitignored .env only); no real network
             call is made in tests (Http::fake in RazorpayPaymentTest). -->
        <env name="RAZORPAY_KEY_ID" value="rzp_test_ci_dummy_key"/>
        <env name="RAZORPAY_KEY_SECRET" value="ci-dummy-secret-not-a-real-credential"/>
        <!-- WhatsApp is switched OFF in tests. The real token lives in .env, and
             booking/confirm tests would otherwise send live WhatsApp messages
             to the made-up phone numbers their factories generate. -->
        <env name="WHATSAPP_ENABLED" value="false"/>
        <env name="WHATSAPP_TOKEN" value=""/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value=""/>
    </php>
</phpunit>
