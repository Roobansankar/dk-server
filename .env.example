APP_NAME="DK StyleHub"
# Production MUST use: APP_ENV=production, APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dk_stylehub
DB_USERNAME=dk_stylehub
DB_PASSWORD=

# Exact scheme+host of the public site and the admin SPA (comma separated).
# In production set these to the real https:// origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

MEDIA_DISK=public
MEDIA_MAX_KB=4096

# First superadmin — set BOTH, then run `php artisan db:seed --class=AdminUserSeeder`
# on deploy. Leave blank otherwise. Never commit real credentials.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin API token lifetime in minutes (blank / 0 = default of 14 days).
SANCTUM_TOKEN_EXPIRATION=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Video uploads (homepage Video section) — App\Support\VideoUploader
# transcodes every upload via ffmpeg. Point these at real binaries (a local
# portable copy works); blank falls back to relying on $PATH. Without a
# working ffmpeg + H.264 encoder, video uploads fail with a 503.
FFMPEG_PATH=
FFPROBE_PATH=

# Application-level video size ceiling in kilobytes (default 25600 = 25 MB).
# Larger files are rejected with a message naming the limit. The server's
# PHP upload_max_filesize/post_max_size must stay ABOVE this, or PHP
# rejects the file before the app's validation runs.
VIDEO_MAX_KB=

# Razorpay Standard Checkout (App\Support\Razorpay) — the booking flow's
# confirmation-fee/advance payment. Use TEST-mode keys (rzp_test_...) locally;
# production must use LIVE keys (rzp_live_...), never TEST-mode ones. Leave
# blank to leave payment collection non-functional (order creation fails
# cleanly, booking creation itself is unaffected).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth (Laravel Socialite) — customer "Continue with Google" sign-in.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console. Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI.
# Leave blank to disable Google sign-in (the button/endpoint fails gracefully).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/account/google/callback

# Origin of the React SPA — used only to build the redirect back to the
# frontend after a Google OAuth callback completes.
FRONTEND_URL=http://localhost:5173

# WhatsApp Cloud API (Meta) — booking confirmation messages.
# WHATSAPP_TOKEN = System User / temporary access token from WhatsApp → API Setup.
# WHATSAPP_PHONE_NUMBER_ID = "Phone number ID" from the same screen.
# WHATSAPP_WABA_ID = WhatsApp Business Account ID (for template management reference).
# WHATSAPP_TEMPLATE_BOOKING_CONFIRMED = approved Utility template name (default booking_confirmed).
# Leave WHATSAPP_TOKEN blank to disable sending (bookings still work).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_ENABLED=true

# WhatsApp webhook — Callback URL in Meta → WhatsApp → Configuration is
#   https://<your-domain>/api/whatsapp/webhook
# WHATSAPP_VERIFY_TOKEN = any secret string you choose; type the SAME value as "Verify token" in Meta.
# WHATSAPP_APP_SECRET = App secret from developers.facebook.com → your app → App settings → Basic.
#   Events (delivery status, replies) are ignored unless they are signed with it.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
